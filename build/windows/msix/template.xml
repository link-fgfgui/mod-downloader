<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="mod-downloader"
        Arguments=""
        InstallLocation="C:\Program Files\link-fgfgui\Mod Downloader">
    </Installer>
    <PackageInformation
        PackageName="Mod Downloader"
        PackageDisplayName="Mod Downloader"
        PublisherName="CN=link-fgfgui"
        PublisherDisplayName="link-fgfgui"
        Version="0.1.0.0"
        PackageDescription="Minecraft mod downloader and instance manager">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.linkfgfgui.moddownloader"
                Description="Minecraft mod downloader and instance manager"
                DisplayName="Mod Downloader"
                ExecutableName="mod-downloader"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Mod Downloader</DisplayName>
            <PublisherDisplayName>link-fgfgui</PublisherDisplayName>
            <Description>Minecraft mod downloader and instance manager</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="mod-downloader.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
